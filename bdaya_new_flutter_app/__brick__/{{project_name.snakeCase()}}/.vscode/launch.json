{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch development",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_development.dart",
      "args": [
        "--flavor",
        "development",
        "--target",
        "lib/main_development.dart",
        "--dart-define",
        "env=real",
        "--web-port",
        "4200",
        "--no-enable-impeller",
        "--dart-define",
        "grpc-url=dev-gateway-invora.inpro.studio",
        "--dart-define",
        "grpc-port=443",
        "--dart-define",
        "grpc-secure=true"
      ]
    },
    {
      "name": "Launch staging",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_staging.dart",
      "args": [
        "--flavor",
        "staging",
        "--target",
        "lib/main_staging.dart",
        "--dart-define",
        "env=real",
        "--web-port",
        "4200",
        "--no-enable-impeller"
      ]
    },
    {
      "name": "Launch production",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_production.dart",
      "args": [
        "--flavor",
        "production",
        "--target",
        "lib/main_production.dart",
        "--web-port",
        "4200",
        "--no-enable-impeller",
        "--dart-define",
        "env=real",
        "--dart-define",
        "grpc-url=gateway.invora.app",
        "--dart-define",
        "grpc-port=443",
        "--dart-define",
        "grpc-secure=true"
      ]
    }
  ]
}
